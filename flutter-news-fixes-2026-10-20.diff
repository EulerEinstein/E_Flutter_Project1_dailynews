diff -ruN orig_lf/lib/features/daily_news/data/models/article_table.dart fixed/lib/features/daily_news/data/models/article_table.dart
--- orig_lf/lib/features/daily_news/data/models/article_table.dart	1970-01-01 00:00:00.000000000 +0000
+++ fixed/lib/features/daily_news/data/models/article_table.dart	2026-10-20 02:15:09.449401102 +0000
@@ -0,0 +1,55 @@
+import 'package:floor_community/floor.dart';
+import 'package:daily_news/features/daily_news/data/models/article.dart';
+import 'package:daily_news/features/daily_news/domain/entities/article.dart';
+
+/// Database row of the table `article` (Floor).
+/// Separate from [ArticleModel] so that every column is declared exactly once.
+@Entity(tableName: 'article')
+class ArticleTable {
+  @PrimaryKey(autoGenerate: true)
+  final int? id;
+  final String? author;
+  final String? title;
+  final String? description;
+  final String? url;
+  final String? urlToImage;
+  final String? publishedAt;
+  final String? content;
+
+  const ArticleTable({
+    this.id,
+    this.author,
+    this.title,
+    this.description,
+    this.url,
+    this.urlToImage,
+    this.publishedAt,
+    this.content,
+  });
+
+  factory ArticleTable.fromEntity(ArticleEntity entity) {
+    return ArticleTable(
+      id: entity.id,
+      author: entity.author,
+      title: entity.title,
+      description: entity.description,
+      url: entity.url,
+      urlToImage: entity.urlToImage,
+      publishedAt: entity.publishedAt,
+      content: entity.content,
+    );
+  }
+
+  ArticleModel toModel() {
+    return ArticleModel(
+      id: id,
+      author: author,
+      title: title,
+      description: description,
+      url: url,
+      urlToImage: urlToImage,
+      publishedAt: publishedAt,
+      content: content,
+    );
+  }
+}
diff -ruN orig_lf/lib/features/daily_news/data/models/articles_response.dart fixed/lib/features/daily_news/data/models/articles_response.dart
--- orig_lf/lib/features/daily_news/data/models/articles_response.dart	1970-01-01 00:00:00.000000000 +0000
+++ fixed/lib/features/daily_news/data/models/articles_response.dart	2026-10-20 02:15:09.449094539 +0000
@@ -0,0 +1,26 @@
+import 'package:daily_news/features/daily_news/data/models/article.dart';
+
+/// The JSON that NewsAPI really returns:
+/// { "status": "ok", "totalResults": 38, "articles": [ {...}, {...} ] }
+class ArticlesResponseModel {
+  final String? status;
+  final int? totalResults;
+  final List<ArticleModel> articles;
+
+  const ArticlesResponseModel({
+    this.status,
+    this.totalResults,
+    this.articles = const [],
+  });
+
+  factory ArticlesResponseModel.fromJson(Map<String, dynamic> map) {
+    final rawList = (map['articles'] as List<dynamic>?) ?? const [];
+    return ArticlesResponseModel(
+      status: map['status'] as String?,
+      totalResults: map['totalResults'] as int?,
+      articles: rawList
+          .map((dynamic e) => ArticleModel.fromJson(e as Map<String, dynamic>))
+          .toList(),
+    );
+  }
+}
